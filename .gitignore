# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.deps/
.downloads/
.tools/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Secrets and local configuration
.env
*.pem
*.key

# Data: only documentation, manifests, and fixed splits are versioned
data/raw/**
data/interim/**
data/processed/**
data/ce-csl/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
data/alignment/
data/isolated/
data/artifacts/
data/manifests/
!data/manifests/*.yaml

# Models and runtime output
artifacts/checkpoints/**
artifacts/exports/**
artifacts/logs/**
artifacts/part3_features/**
!artifacts/checkpoints/.gitkeep
!artifacts/exports/.gitkeep
!artifacts/logs/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx
*.tflite

# Participant and consent material must never enter Git
data/participants/
docs/ethics/consent-forms/

# Build output
build/
dist/
*.egg-info/

# blank-governance experiment scratch: large derived caches and link farms
# (JSON receipts under artifacts/metrics/blank-gov/ ARE tracked on purpose)
artifacts/metrics/blank-gov/*.npz
.vocab_link/
.p15_feats/
.p4_frames/
.a2_cache/
.venv_mp/
models/*.task
